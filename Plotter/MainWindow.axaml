<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Plotter.MainWindow"
        Title="Plotter">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="8">
            <Button x:Name="BtnToggleIndexes" Content="Toggle Render Indexes" Click="BtnToggleIndexes_Click"/>
        </StackPanel>

        <ScottPlot:AvaPlot Name="AvaPlot1"/>
    </DockPanel>
</Window>
